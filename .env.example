# ============================================================
# MeasureSoftGram-Platform — fonte UNICA de configuracao.
#   cp .env.example .env   e preencha a secao "GitHub OAuth".
# Tudo sobe em modo dev (hot reload); mudou uma env var, basta
#   docker compose up -d <servico>   (reinicia so ele, sem rebuild).
# ============================================================

# Servicos que sobem com `docker compose up -d` (ou `make select`).
# Opcoes (combine com virgula): service front grafana ai docs
# service/front tambem sobem db+proxy automaticamente.
COMPOSE_PROFILES=service,front,grafana

# ---- Entrada publica ----
PROXY_PORT=80
# se mudar PROXY_PORT, inclua a porta em PUBLIC_URL (ex: http://localhost:8081)
PUBLIC_URL=http://localhost

# ---- Postgres (servico "db") ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres           # dev local; troque em qualquer ambiente exposto

# ---- Django / Service ----
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=django-insecure-troque-esta-chave-em-producao
DEBUG=TRUE
CREATE_FAKE_DATA=TRUE                # popula orgs/produtos fake + superusuario admin/admin
AMBIENT_TEST_OR_DEV=TRUE
RUN_LOAD_INITIAL_DATA=true

# Superusuario do Django admin (tambem serve para login user/senha no Front)
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@admin.com
SUPERADMIN_PASSWORD=admin

# Os dados fake do seed pertencem a ESTE usuario e so aparecem para membros
# da organizacao. Para ve-los logando com GitHub, troque para o SEU login do
# GitHub e rode `docker compose exec service python manage.py load_initial_data`.
# Para ve-los logando com admin/admin, use scripts/grant-access.sh admin.
SEED_GITHUB_USERNAME=msgramteste
SEED_GITHUB_EMAIL=msgram.teste@gmail.com
ALLOWED_HOSTS=localhost,127.0.0.1,service,proxy
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
FRONTEND_DEV_URL=http://localhost
FRONTEND_PROD_URL=http://localhost

# ---- GitHub OAuth (PREENCHER) ----
# Crie em https://github.com/settings/developers > New OAuth App
#   Homepage URL:               http://localhost
#   Authorization callback URL: http://localhost   (identico a LOGIN_REDIRECT_URL)
# GITHUB_CLIENT_ID / LOGIN_REDIRECT_URL alimentam OS DOIS LADOS
# (build arg do Front + environment do Service) e precisam ser identicos ao OAuth App.
LOGIN_REDIRECT_URL=http://localhost
GITHUB_CLIENT_ID=
GITHUB_SECRET=
# Personal Access Token (repo, read:org) para coleta de metricas do GitHub
GITHUB_TOKEN=

# ---- Front (profile front — lido em runtime pelo `next dev`) ----
NEXT_PUBLIC_API_URL=http://localhost/api      # sem /v1 — o axios ja chama /v1/...
SERVICE_URL=http://service:8080/api

# ---- Grafana ----
GRAFANA_BASE_URL=http://grafana:3000
GRAFANA_PUBLIC_URL=http://localhost/grafana
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=admin123            # vai para GF_SECURITY_ADMIN_PASSWORD

# ---- Action (profile tools) ----
MSGRAM_SERVICE_HOST=http://service:8080
MSGRAM_TOKEN=
SONAR_TOKEN=

# ---- CLI (profile tools) ----
LOG=verbose

# ---- MCP / AI (profile ai) ----
# O servidor MCP usa estas credenciais para falar com a API do Service
# (casam com o seed admin/admin). SERVICE default = http://service:8080/api/v1/
MCP_PORT=8000
MCP_INSPECTOR_PORT=6274
MCP_TRANSPORT=streamable-http
MSGRAM_USER=admin
MSGRAM_PASSWORD=admin

# ---- Docs (profile docs) ----
DOCS_PORT=3001
